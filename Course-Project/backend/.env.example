# Copy to backend/.env. Keys stay on the server. Never commit .env.
PORT=3000
GRANT_LLM=ollama
OLLAMA_MODEL=qwen2.5:3b
AURA_LLM=on
AURA_LLM_CONCURRENCY=1
OPENALEX_API_KEY=
# Optional: select GRANT_LLM=groq explicitly to use a cloud model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# MongoDB is optional; blank uses a persistent local JSON store.
MONGODB_URI=
MONGODB_DB=research_grant
